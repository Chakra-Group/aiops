{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "instructions": [
    "chakra-agents/agentic/rules/*.md"
  ],
  "agent": {
    "orchestrator": {
      "description": "Lead AI Systems Architect & Digital Workforce Orchestrator (EMP-AI-000). Reports to MD-000. Coordinates 21 core AI employees, 5 UAT customer personas, 4 Cyber Red-Team Auditors, and the 6-Stage Agentic SDLC across dev/uat/prod environments.",
      "mode": "primary",
      "model": "opencode/deepseek-v4.1-flash-free",
      "fallback_models": [

        // OpenCode free models
        "opencode/mimo-v2.6-flash-free",
        "opencode/nemotron-3.5-lightning-free",
        "opencode/hy4-flash-free",
        "opencode/beam-free",
        "opencode/flint-40b-free",
        "opencode/big-pickle",
        "opencode/iceman-free",
        "opencode/tidepool-alpha-free",

        // OpenRouter free models
        "openrouter/baidu/ernie-5.5-flash-preview:free",
        "openrouter/google/gemma-4-31b-it:free",
        "openrouter/inclusionai/ling-3.2-flash:free",
        "openrouter/nvidia/nemotron-3.5-lightning:free",
        "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
        "openrouter/particle-ai/particle-1:free",
        "openrouter/recursive/flint-v1.0:free",
        "openrouter/google/gemma-4-26b-a4b-it:free",
        "openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
        "openrouter/liquid/lfm-3-1.7b:free",
        "openrouter/nvidia/nemotron-3.5-super-vl:free",
        "openrouter/openrouter/free",

        // ==================================
        // GROQ MODELS - PAID API FALLBACKS
        // ==================================
        "groq/openai/gpt-oss-120b",
        "groq/openai/gpt-oss-20b"
      ],
      "prompt": "Before acting, read the version-controlled canonical instructions: chakra-agents/agentic/AGENTS.md and chakra-agents/agentic/rules/*.md.\n{file:chakra-agents/docs/HEAD_COORDINATOR_OPERATIONS.md}"
    },
    "researcher": {
      "description": "Researches the codebase for technical blockers, edge cases, cross-platform discrepancies, and unblocking solutions across all 12 Chakra repositories.",
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free",
      "fallback_models": [

        // OpenCode free models
        "opencode/mimo-v2.6-flash-free",
        "opencode/nemotron-3.5-lightning-free",
        "opencode/hy4-flash-free",
        "opencode/beam-free",
        "opencode/flint-40b-free",
        "opencode/big-pickle",
        "opencode/iceman-free",
        "opencode/tidepool-alpha-free",

        // OpenRouter free models
        "openrouter/baidu/ernie-5.5-flash-preview:free",
        "openrouter/google/gemma-4-31b-it:free",
        "openrouter/inclusionai/ling-3.2-flash:free",
        "openrouter/nvidia/nemotron-3.5-lightning:free",
        "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
        "openrouter/particle-ai/particle-1:free",
        "openrouter/recursive/flint-v1.0:free",
        "openrouter/google/gemma-4-26b-a4b-it:free",
        "openrouter/nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free",
        "openrouter/liquid/lfm-3-1.7b:free",
        "openrouter/nvidia/nemotron-3.5-super-vl:free",
        "openrouter/openrouter/free",

        // ==================================
        // GROQ MODELS - PAID API FALLBACKS
        // ==================================
        "groq/openai/gpt-oss-120b",
        "groq/openai/gpt-oss-20b"
      ],
      "prompt": "You research the codebase for technical blockers, edge cases and cross-platform discrepancies. Read files on demand with tools. Do not assume file contents."
    }
  }
}